# =========================
# ProdTraceRAG .env example
# =========================
# Copy to .env (or export in your shell) and adjust values.

# ---- Service hardening (recommended for internet-facing deployment) ----
AUTH_REQUIRED=1
PRODTRACERAG_API_TOKEN=replace-with-long-random-public-token
PRODTRACERAG_ADMIN_TOKEN=replace-with-long-random-admin-token

# If behind a reverse proxy (nginx/traefik), and you trust it:
TRUST_PROXY_HEADERS=1

# IP allowlists (optional)
PUBLIC_ALLOWLIST_CIDRS=0.0.0.0/0
ADMIN_ALLOWLIST_CIDRS=127.0.0.1/32

# Disable interactive docs on public deployments
ENABLE_DOCS=0
ENABLE_REDOC=0

# ---- Local ingestion safety ----
INGEST_REQUIRE_ALLOWLIST=1
INGEST_ALLOWED_ROOTS=/srv/prodtracerag/corpus
# Optional extra restriction (only allow paths under repo root)
# INGEST_RESTRICT_TO_PROJECT_ROOT=1

# Allowed globs for /ingest_local
INGEST_ALLOWED_GLOBS=**/*.md,**/*.txt,*.md,*.txt

# Max chars read per file when ingesting
INGEST_MAX_CHARS_PER_FILE=400000

# ---- Redaction controls ----
# Return snippets in /ask citations (turn off on public internet if documents are sensitive)
EXPOSE_CITATION_SNIPPETS=1
PUBLIC_CITATION_SNIPPET_MAX=320

# Tracing (redacted by default)
TRACE_REDACT_ON_WRITE=1
TRACE_REDACT_QUERY=1
TRACE_REDACT_ANSWER=1
TRACE_REDACT_SNIPPETS=1
TRACE_ALLOW_RAW_EXPORT=0

# Public /config response
PUBLIC_CONFIG_SHOW_PATHS=0
PUBLIC_CONFIG_SHOW_MODEL=0

# ---- Existing runtime options (examples) ----
LLM_PROVIDER=none
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# QWEN_API_KEY=
# QWEN_MODEL=qwen-plus
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

ALPHA=0.65
MIN_EVIDENCE_SCORE=0.25
CLARIFY_MAX_SCORE=0.60
STRICT_CITATION=1
ENABLE_BM25=1
ENABLE_EXPANSION=1
ENABLE_DIVERSITY=1
ENABLE_TRACING=1
LLM_FAIL_OPEN=1
